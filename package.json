{
  "name": "layer-erp",
  "version": "1.0.0",
  "description": "Layer ERP - Poultry Farm Management System",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "start": "electron .",
    "build:renderer": "cd renderer && npm install && npm run build",
    "dist": "npm run build:renderer && electron-builder",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "electron": "^28.3.3",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0"
  },
  "build": {
    "appId": "com.layererp.app",
    "productName": "Layer ERP",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "database/**/*",
      "renderer/dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}